{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fahis",
  "version": "1.0.0",
  "identifier": "com.alequab.fahis",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "alequab",
    "copyright": "Copyright 2026 alequab",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../build/backend/fahis-backend/": "backend/",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true
      }
    }
  }
}
